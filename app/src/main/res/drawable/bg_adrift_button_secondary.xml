<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#3326BFDA" />
            <stroke
                android:width="1dp"
                android:color="@color/adrift_border_focus" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#660A1829" />
            <stroke
                android:width="1dp"
                android:color="@color/adrift_border" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</selector>
