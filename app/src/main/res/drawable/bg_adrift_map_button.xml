<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#3326BFDA" />
            <stroke
                android:width="1dp"
                android:color="@color/adrift_border_focus" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ad_map_chip_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/adrift_border" />
        </shape>
    </item>
</selector>
