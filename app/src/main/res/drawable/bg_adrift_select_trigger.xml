<?xml version="1.0" encoding="utf-8"?>
<!-- 對應網頁版 .ui-select-trigger：背景 input-bg、邊框 input-border，展開/按下時邊框變 accent-strong -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ad_input_hover_bg" />
            <stroke android:width="1dp" android:color="@color/ad_accent" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ad_input_hover_bg" />
            <stroke android:width="1dp" android:color="@color/ad_accent" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ad_input_bg" />
            <stroke android:width="1dp" android:color="@color/ad_input_border" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
