<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#33E06166" />
            <stroke
                android:width="1dp"
                android:color="@color/adrift_error" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#1FE06166" />
            <stroke
                android:width="1dp"
                android:color="#80E06166" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</selector>
