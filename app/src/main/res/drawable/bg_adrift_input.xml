<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/ad_input_pressed_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/adrift_border_focus" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/ad_control_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/adrift_divider" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/ad_input_focus_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/adrift_border" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</selector>
