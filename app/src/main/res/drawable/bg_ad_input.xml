<?xml version="1.0" encoding="utf-8"?>
<!-- 網頁版輸入框：input-bg 底、input-border 邊框，聚焦時邊框變 accent -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ad_input_bg" />
            <stroke android:width="1dp" android:color="@color/ad_accent" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ad_input_bg" />
            <stroke android:width="1dp" android:color="@color/ad_input_border" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
