<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md"
    android:background="@drawable/bg_adrift_card"
    android:orientation="vertical"
    android:padding="@dimen/space_md">

    <LinearLayout
        android:id="@+id/layout_explore_author"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp">

            <ImageView
                android:id="@+id/iv_explore_author_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_adrift_avatar"
                android:contentDescription="作者頭像"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_explore_author_avatar"
                style="@style/Text.Adrift.Headline"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_adrift_avatar"
                android:gravity="center"
                android:text="A" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_explore_author"
                style="@style/Text.Adrift.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Adrift 使用者"
                android:textColor="@color/adrift_text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_explore_meta"
                style="@style/Text.Adrift.Metadata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="公開日記" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_explore_title"
        style="@style/Text.Adrift.Title2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:maxLines="2"
        android:text="日記標題" />

    <TextView
        android:id="@+id/tv_explore_body"
        style="@style/Text.Adrift.BodySecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:maxLines="4"
        android:text="日記內容" />

    <ImageView
        android:id="@+id/iv_explore_image"
        android:layout_width="match_parent"
        android:layout_height="188dp"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_image_placeholder"
        android:contentDescription="日記圖片"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_explore_place"
        style="@style/Text.Adrift.Metadata"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:maxLines="1"
        android:text="位置" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_react_understand"
            style="@style/Widget.Adrift.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="@dimen/space_xs"
            android:layout_weight="1"
            android:contentDescription="送出理解反應"
            android:minHeight="0dp"
            android:text="懂 0"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_react_hug"
            style="@style/Widget.Adrift.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="@dimen/space_xs"
            android:layout_weight="1"
            android:contentDescription="送出擁抱反應"
            android:minHeight="0dp"
            android:text="抱 0"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_react_relate"
            style="@style/Widget.Adrift.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:contentDescription="送出共鳴反應"
            android:minHeight="0dp"
            android:text="共 0"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
