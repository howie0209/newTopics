<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_adrift_background">

    <fragment
        android:id="@+id/register_map_background"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B802050D" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="@dimen/space_lg">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/adrift_surface_glass"
            app:cardCornerRadius="@dimen/radius_xl"
            app:cardElevation="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_adrift_glass"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    style="@style/Text.Adrift.Metadata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="CREATE IDENTITY"
                    android:textColor="@color/adrift_accent" />

                <TextView
                    style="@style/Text.Adrift.LargeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:text="建立 Adrift 身份" />

                <TextView
                    style="@style/Text.Adrift.BodySecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:layout_marginBottom="@dimen/space_lg"
                    android:gravity="center"
                    android:text="讓日記、安全與好友同步到正式 Backend" />

                <TextView
                    style="@style/Text.Adrift.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="用戶名稱"
                    android:textColor="@color/adrift_accent" />

                <EditText
                    android:id="@+id/et_register_username"
                    style="@style/Widget.Adrift.Input"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/space_xs"
                    android:layout_marginBottom="@dimen/space_md"
                    android:hint="你的顯示名稱" />

                <TextView
                    style="@style/Text.Adrift.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="使用者 ID"
                    android:textColor="@color/adrift_accent" />

                <EditText
                    android:id="@+id/et_register_user_code"
                    style="@style/Widget.Adrift.Input"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/space_xs"
                    android:layout_marginBottom="@dimen/space_md"
                    android:hint="4-20 位英數、底線或連字號"
                    android:inputType="text" />

                <TextView
                    style="@style/Text.Adrift.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="電子郵件"
                    android:textColor="@color/adrift_accent" />

                <EditText
                    android:id="@+id/et_register_email"
                    style="@style/Widget.Adrift.Input"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/space_xs"
                    android:layout_marginBottom="@dimen/space_md"
                    android:hint="name@example.com"
                    android:inputType="textEmailAddress" />

                <TextView
                    style="@style/Text.Adrift.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="密碼"
                    android:textColor="@color/adrift_accent" />

                <EditText
                    android:id="@+id/et_register_password"
                    style="@style/Widget.Adrift.Input"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/space_xs"
                    android:layout_marginBottom="@dimen/space_md"
                    android:hint="至少 6 個字元"
                    android:inputType="textPassword" />

                <TextView
                    style="@style/Text.Adrift.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="確認密碼"
                    android:textColor="@color/adrift_accent" />

                <EditText
                    android:id="@+id/reg_confirm_password"
                    style="@style/Widget.Adrift.Input"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/space_xs"
                    android:layout_marginBottom="@dimen/space_lg"
                    android:hint="再次輸入密碼"
                    android:inputType="textPassword" />

                <Button
                    android:id="@+id/btn_register_submit"
                    style="@style/Widget.Adrift.Button.Primary"
                    android:layout_width="match_parent"
                    android:text="註冊" />

                <TextView
                    android:id="@+id/tv_go_login"
                    style="@style/Text.Adrift.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/space_md"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="已有帳號？登入"
                    android:textColor="@color/adrift_accent" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>
</FrameLayout>
