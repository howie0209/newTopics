<?xml version="1.0" encoding="utf-8"?>
<!-- 通知清單，對齊網頁版 NotificationList -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_adrift_background"
    android:orientation="vertical"
    android:padding="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_notifications_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_adrift_map_button"
            android:contentDescription="返回"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/ad_text"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="通知"
                android:textColor="@color/ad_text"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_notifications_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="你的互動都在這裡"
                android:textColor="@color/ad_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_notifications_read_all"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_ad_pill"
            android:contentDescription="全部標記已讀"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="✓ 全部已讀"
            android:textColor="@color/ad_text"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_notifications_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_ad_note"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/tv_notifications_error"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ad_danger"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/btn_notifications_reload"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_ad_pill"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="↻ 重新載入"
            android:textColor="@color/ad_text"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_notifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/layout_notifications_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔"
                android:textSize="26sp" />
            <TextView
                android:id="@+id/tv_notifications_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="目前沒有通知"
                android:textColor="@color/ad_text"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="好友邀請、回應與記憶共鳴會出現在這裡。"
                android:textColor="@color/ad_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
