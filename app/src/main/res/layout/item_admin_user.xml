<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_edittext_dark"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_admin_user_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_admin_user_role"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_adrift_map_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/cyan_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_admin_user_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/hint_text"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_admin_user_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/hint_text"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_admin_user_created"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/hint_text"
        android:textSize="11sp" />

    <Button
        android:id="@+id/btn_admin_user_delete"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="刪除使用者"
        android:textColor="#FFAB6B"
        android:visibility="gone" />
</LinearLayout>