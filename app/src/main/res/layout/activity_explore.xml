<?xml version="1.0" encoding="utf-8"?>
<!-- 動態牆，對齊網頁版 FeedPage（取代原本的「探索」） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_adrift_background"
    android:orientation="vertical"
    android:padding="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="CITY MEMORIES"
                android:textColor="@color/ad_mint"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                style="@style/Text.Adrift.Title1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="動態牆"
                android:textColor="@color/ad_text" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="看看你與朋友，最近在城市留下了什麼記憶。"
                android:textColor="@color/ad_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_feed_new_diary"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/ad_mint"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="12dp"
            android:text="＋ 留下記憶"
            android:textAllCaps="false"
            android:textColor="@color/ad_on_mint"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/space_md"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_adrift_bottom_nav"
            android:orientation="horizontal"
            android:padding="3dp">
            <TextView
                android:id="@+id/tab_feed_all"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="全部"
                android:textColor="@color/ad_text"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tab_feed_friends"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="好友"
                android:textColor="@color/ad_text_secondary"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tab_feed_public"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="公開"
                android:textColor="@color/ad_text_secondary"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_feed_refresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_adrift_bottom_nav"
            android:contentDescription="重新整理動態"
            android:gravity="center"
            android:text="↻"
            android:textColor="@color/ad_text"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_feed_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:background="@drawable/bg_ad_note"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/tv_feed_error"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ad_danger"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/btn_feed_retry"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_ad_pill"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="再試一次"
            android:textColor="@color/ad_text"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_explore_diaries"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tv_feed_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="正在讀取動態…"
            android:textColor="@color/ad_text_secondary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_feed_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌊"
                android:textSize="28sp" />
            <TextView
                android:id="@+id/tv_feed_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="附近還很安靜"
                android:textColor="@color/ad_text"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="先把這裡變成你的記憶地圖。即使只有自己可見，也能在未來回顧今天。"
                android:textColor="@color/ad_text_secondary"
                android:textSize="13sp" />
            <Button
                android:id="@+id/btn_feed_empty_new"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:text="＋ 留下第一篇日記"
                android:textAllCaps="false"
                android:textColor="@color/ad_accent" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_adrift_bottom_nav"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/space_xs">

        <TextView
            android:id="@+id/explore_nav_map"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="地圖"
            android:textColor="@color/adrift_text_secondary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/explore_nav_friends"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="好友"
            android:textColor="@color/adrift_text_secondary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/explore_nav_explore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_adrift_nav_item"
            android:contentDescription="目前在動態"
            android:gravity="center"
            android:text="動態"
            android:textColor="@color/adrift_text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/explore_nav_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="切換到 Adrift Intelligence"
            android:gravity="center"
            android:text="Adrift Intelligence"
            android:textColor="@color/adrift_text_secondary"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
