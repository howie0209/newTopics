<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_adrift_background"
    android:orientation="vertical"
    android:padding="@dimen/space_md">

    <ImageButton
        android:id="@+id/btn_profile_back"
        android:layout_width="@dimen/touch_target"
        android:layout_height="@dimen/touch_target"
        android:background="@drawable/bg_adrift_floating_control"
        android:contentDescription="返回"
        android:src="@android:drawable/ic_menu_revert"
        android:tint="@color/adrift_text_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_adrift_glass"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp">

            <ImageView
                android:id="@+id/iv_profile_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_adrift_avatar"
                android:contentDescription="使用者頭像"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_profile_avatar"
                style="@style/Text.Adrift.Title1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_adrift_avatar"
                android:gravity="center"
                android:text="A" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_profile_name"
            style="@style/Text.Adrift.Title1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:maxLines="2"
            android:text="使用者" />

        <TextView
            android:id="@+id/tv_profile_code"
            style="@style/Text.Adrift.BodySecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@user" />

        <TextView
            android:id="@+id/tv_profile_status"
            style="@style/Text.Adrift.Metadata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:text="好友狀態" />

        <Button
            android:id="@+id/btn_profile_primary"
            style="@style/Widget.Adrift.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_md"
            android:text="主要動作" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_adrift_card"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <TextView
            style="@style/Text.Adrift.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="可見日記" />

        <TextView
            android:id="@+id/tv_profile_diary_stats"
            style="@style/Text.Adrift.BodySecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="尚未取得日記統計" />
    </LinearLayout>
</LinearLayout>
