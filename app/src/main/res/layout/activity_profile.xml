<?xml version="1.0" encoding="utf-8"?>
<!-- 個人資料，對齊網頁版 FriendProfile：身分、好友動作、統計、可見記憶、共同地點 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_adrift_background"
    android:orientation="vertical"
    android:padding="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/btn_profile_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_adrift_map_button"
            android:contentDescription="關閉個人資料"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/ad_text"
            android:textSize="22sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="個人資料"
            android:textColor="@color/ad_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_adrift_glass"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp">
                    <ImageView
                        android:id="@+id/iv_profile_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_adrift_avatar"
                        android:contentDescription="使用者頭像"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/tv_profile_avatar"
                        style="@style/Text.Adrift.Title1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_adrift_avatar"
                        android:gravity="center"
                        android:text="A" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_profile_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="使用者"
                    android:textColor="@color/ad_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_profile_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="\@user"
                    android:textColor="@color/ad_text_muted"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tv_profile_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/ad_text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btn_profile_primary"
                        style="@style/Widget.Adrift.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:minHeight="0dp"
                        android:text="加入好友"
                        android:textSize="13sp" />
                    <Button
                        android:id="@+id/btn_profile_secondary"
                        style="@style/Widget.Adrift.Button.Danger"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:minHeight="0dp"
                        android:text="拒絕"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tv_profile_stat_public"
                        style="@style/Widget.Adrift.Stat"
                        android:text="0\n公開記憶" />
                    <TextView
                        android:id="@+id/tv_profile_stat_friends"
                        style="@style/Widget.Adrift.Stat"
                        android:layout_marginHorizontal="6dp"
                        android:text="0\n好友限定" />
                    <TextView
                        android:id="@+id/tv_profile_stat_joined"
                        style="@style/Widget.Adrift.Stat"
                        android:text="-\n加入 Adrift" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_profile_tabs"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_adrift_bottom_nav"
                android:orientation="horizontal"
                android:padding="3dp">
                <TextView
                    android:id="@+id/tab_profile_memories"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="📖 可見記憶"
                    android:textColor="@color/ad_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tab_profile_places"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="📍 共同地點"
                    android:textColor="@color/ad_text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_profile_list_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/ad_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/layout_profile_memories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btn_profile_more"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="載入更多記憶"
                android:textAllCaps="false"
                android:textColor="@color/ad_accent"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layout_profile_places"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
