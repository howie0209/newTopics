<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_edittext_dark"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tv_location_place"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_location_mood"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_adrift_map_chip"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:textColor="@color/cyan_primary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tv_location_insight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/hint_text"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp" />
</LinearLayout>