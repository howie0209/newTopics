<?xml version="1.0" encoding="utf-8"?>
<!-- 好友，對齊網頁版 FriendsPage：我的好友／好友邀請／探索使用者 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_adrift_background"
    android:orientation="vertical"
    android:padding="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="ADRIFT SOCIAL HUB"
                android:textColor="@color/ad_mint"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                style="@style/Text.Adrift.Title1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="好友"
                android:textColor="@color/ad_text" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="與朋友一起，留下屬於你們的城市記憶。"
                android:textColor="@color/ad_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/btn_friends_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_adrift_map_button"
            android:contentDescription="重新整理"
            android:gravity="center"
            android:text="↻"
            android:textColor="@color/ad_text"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tv_stat_friends"
            style="@style/Widget.Adrift.Stat"
            android:text="0\n位好友" />
        <TextView
            android:id="@+id/tv_stat_received"
            style="@style/Widget.Adrift.Stat"
            android:layout_marginHorizontal="6dp"
            android:text="0\n待處理邀請" />
        <TextView
            android:id="@+id/tv_stat_sent"
            style="@style/Widget.Adrift.Stat"
            android:text="0\n已送出邀請" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_copy_my_code"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_ad_pill"
        android:gravity="center"
        android:text="📋 複製我的 ID  @user"
        android:textColor="@color/ad_text"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_adrift_bottom_nav"
        android:orientation="horizontal"
        android:padding="3dp">
        <TextView
            android:id="@+id/tab_friends_list"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="我的好友"
            android:textColor="@color/ad_text"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tab_friends_invites"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="好友邀請"
            android:textColor="@color/ad_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tab_friends_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="探索使用者"
            android:textColor="@color/ad_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_friends_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/ad_text_secondary"
        android:textSize="12sp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 我的好友 -->
            <LinearLayout
                android:id="@+id/panel_friends"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <EditText
                        android:id="@+id/et_friend_filter"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ad_input"
                        android:hint="🔍 搜尋好友名稱或 ID"
                        android:inputType="text"
                        android:maxLength="40"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/ad_text"
                        android:textColorHint="@color/ad_text_faint"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/btn_friend_sort"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_ad_pill"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="排序：名稱"
                        android:textColor="@color/ad_text"
                        android:textSize="12sp" />
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_friends"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <!-- 好友邀請 -->
            <LinearLayout
                android:id="@+id/panel_invites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tab_friends_received"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ad_pill"
                        android:gravity="center"
                        android:text="收到的邀請 0"
                        android:textColor="@color/ad_text"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tab_friends_sent"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="已送出邀請 0"
                        android:textColor="@color/ad_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_received"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_sent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 探索使用者 -->
            <LinearLayout
                android:id="@+id/panel_friend_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="找到城市故事裡的人"
                    android:textColor="@color/ad_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/et_friend_code"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_ad_input"
                    android:hint="🔍 輸入名稱或 @使用者 ID"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLength="40"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/ad_text"
                    android:textColorHint="@color/ad_text_faint"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="輸入至少 2 個字；使用者 ID 可精確比對，名稱支援部分搜尋。"
                    android:textColor="@color/ad_text_muted"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tv_search_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/ad_text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_search_results"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="可能認識的人"
                        android:textColor="@color/ad_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="根據共同好友"
                        android:textColor="@color/ad_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tv_recommend_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="正在整理好友連結…"
                    android:textColor="@color/ad_text_secondary"
                    android:textSize="12sp" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_recommendations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_adrift_bottom_nav"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/space_xs">

        <TextView
            android:id="@+id/friends_nav_map"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="地圖"
            android:textColor="@color/adrift_text_secondary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/friends_nav_friends"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_adrift_nav_item"
            android:contentDescription="目前在好友"
            android:gravity="center"
            android:text="好友"
            android:textColor="@color/adrift_text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/friends_nav_explore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="切換到探索"
            android:gravity="center"
            android:text="動態"
            android:textColor="@color/adrift_text_secondary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/friends_nav_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="切換到 Adrift Intelligence"
            android:gravity="center"
            android:text="Adrift Intelligence"
            android:textColor="@color/adrift_text_secondary"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
