<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A111E"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="帳號設定"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_edittext_dark"
        android:padding="16dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/tv_settings_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="使用者名稱"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_settings_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="email@example.com"
            android:textColor="#A0A0A0"
            android:textSize="14dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tv_settings_join_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="註冊日期：---- -- --"
            android:textColor="#66FFFFFF"
            android:textSize="12sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/header_edit_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✏️ 修改使用者名稱"
                android:textColor="#8AB4F8"
                android:textSize="16sp"
                android:padding="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

            <LinearLayout
                android:id="@+id/layout_edit_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/et_new_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="輸入新的名稱"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#55FFFFFF"
                    android:background="@drawable/bg_edittext_dark"
                    android:padding="12dp" />

                <Button
                    android:id="@+id/btn_save_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="儲存新名稱"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1FFFFFFF" />

            <TextView
                android:id="@+id/header_edit_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✉️ 變更電子信箱"
                android:textColor="#8AB4F8"
                android:textSize="16sp"
                android:padding="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

            <LinearLayout
                android:id="@+id/layout_edit_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/et_current_pwd_for_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="請輸入目前密碼以驗證身份"
                    android:inputType="textPassword"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#55FFFFFF"
                    android:background="@drawable/bg_edittext_dark"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/et_new_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="輸入新的電子信箱"
                    android:inputType="textEmailAddress"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#55FFFFFF"
                    android:background="@drawable/bg_edittext_dark"
                    android:padding="12dp" />

                <Button
                    android:id="@+id/btn_save_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="驗證並更新 Email"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1FFFFFFF" />

            <TextView
                android:id="@+id/header_edit_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔒 變更帳號密碼"
                android:textColor="#8AB4F8"
                android:textSize="16sp"
                android:padding="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

            <LinearLayout
                android:id="@+id/layout_edit_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/et_current_pwd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="目前密碼"
                    android:inputType="textPassword"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#55FFFFFF"
                    android:background="@drawable/bg_edittext_dark"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/et_new_pwd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="新密碼 (至少 6 個字元)"
                    android:inputType="textPassword"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#55FFFFFF"
                    android:background="@drawable/bg_edittext_dark"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/et_confirm_pwd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="再次確認新密碼"
                    android:inputType="textPassword"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#55FFFFFF"
                    android:background="@drawable/bg_edittext_dark"
                    android:padding="12dp" />

                <Button
                    android:id="@+id/btn_save_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="更新密碼"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1FFFFFFF" />

            <TextView
                android:id="@+id/header_danger_zone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🚨 永久刪除此帳號"
                android:textColor="#FF6B6B"
                android:textSize="16sp"
                android:padding="12dp"
                android:layout_marginTop="32dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>