<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="13dp"
    android:paddingEnd="15dp"
    android:paddingBottom="12dp"
    android:minHeight="86dp"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/bg_ad_memory_item">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ad_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tv_heart_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❤️ 0"
                android:textColor="@color/ad_text_dim"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tv_smile_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤗 0"
                android:textColor="@color/ad_text_dim"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tv_surprise_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌧 0"
                android:textColor="@color/ad_text_dim"
                android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tv_item_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="\@username"
                android:textColor="@color/ad_text_dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_item_edited"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_adrift_map_chip"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="已編輯"
                android:textColor="@color/adrift_text_secondary"
                android:textSize="10sp"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_item_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ad_text_dim"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tv_item_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/ad_text"
        android:textSize="18sp" />

</LinearLayout>